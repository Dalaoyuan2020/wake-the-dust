page {
  background: #111;
  color: #f2f2f2;
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", sans-serif;
}
.wrap { padding: 32rpx; }
.h1 { font-size: 56rpx; font-weight: 640; }
.sub { color: #888; margin-top: 8rpx; }
.card {
  background: #1c1c1c;
  border-radius: 24rpx;
  padding: 32rpx;
  margin-top: 24rpx;
}
.gold { color: #f5c15c; }
.btn {
  margin-top: 32rpx;
  background: #f5c15c;
  color: #111;
  border-radius: 999rpx;
  text-align: center;
  padding: 24rpx;
  font-weight: 600;
}
.btn-ghost {
  background: transparent;
  color: #f5c15c;
  border: 1px solid #f5c15c;
}
